# Grant Fine Print — environment variables
# Copy this file to .env (gitignored) and fill in real values.
# NEVER commit real secrets or put them in config.yaml.

# Tinker OpenAI-compatible inference endpoint.
# Tinker documents this endpoint at:
# https://tinker-docs.thinkingmachines.ai/tinker/compatible-apis/openai/
GFP_PROVIDER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1

# Tinker API key. Keep this secret and never commit it.
TINKER_API_KEY=

# Backwards-compatible alias accepted by the current HTTP adapter.
GFP_API_KEY=

# Tinker model identifiers. The fine-tuned value is filled after the training
# script saves a sampler checkpoint (tinker://.../sampler_weights/...).
GFP_PROVIDER=tinker
GFP_BASE_MODEL=Qwen/Qwen3.5-4B
GFP_FINE_TUNED_MODEL=

# Optional product contact links.
GFP_SUPPORT_EMAIL=
GFP_SUPPORT_PHONE=
